---
import { servicePages } from '../content/service-pages';
import { services } from '../content/services';

const pageFor = (serviceId: string) => servicePages.find((page) => page.serviceId === serviceId);
import FloatingObject from './FloatingObject.astro';

const decor = {
  core: { kind: 'bead', tone: 'amber', style: 'width:6rem;height:6rem;right:2rem;top:2rem' },
  vision: {
    kind: 'capsule',
    tone: 'indigo',
    style: 'width:2.8rem;height:7rem;right:2rem;bottom:1.5rem',
  },
  glass: {
    kind: 'bead',
    tone: 'teal',
    style: 'width:4.5rem;height:4.5rem;right:1.6rem;top:1.6rem',
  },
  teal: {
    kind: 'spark',
    tone: 'pearl',
    style: 'width:3.4rem;height:3.4rem;right:2rem;bottom:1.8rem',
  },
} as const;
---

<section
  class="services section"
  id="services"
  aria-labelledby="services-title"
  data-testid="services"
>
  <div class="aura" style="--aura-color:rgb(25 181 165 / .2);top:10%;right:-24rem"></div>
  <div class="container">
    <div class="section-heading reveal">
      <h2 id="services-title">Everything your site needs, nothing it does not.</h2>
      <p>Four ways to work with us, each built around your core idea and shipped fast.</p>
    </div>

    <ul class="bento">
      {services.map((service) => {
        const art = decor[service.tone];
        return (
          <li class={`cell tone-${service.tone} reveal`} id={`service-${service.id}`}>
            <FloatingObject kind={art.kind} tone={art.tone} style={art.style} />
            <h3>{service.title}</h3>
            <p class="summary">{service.summary}</p>
            <ul class="points">
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            {pageFor(service.id) && (
              <a class="more" href={`/services/${pageFor(service.id)?.slug}`}>
                Learn more
                <span class="sr-only"> about {service.title}</span>
              </a>
            )}
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cell {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    gap: 0.9rem;
    min-height: 18rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: var(--radius-card);
    border: 1px solid rgb(255 255 255 / 0.7);
    overflow: hidden;
  }

  h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    max-width: 16ch;
  }

  .summary {
    max-width: 30rem;
    font-size: 1.02rem;
  }

  .more {
    width: fit-content;
    color: inherit;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .points li {
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 500;
    background: rgb(255 255 255 / 0.16);
    border: 1px solid rgb(255 255 255 / 0.28);
  }

  .tone-core {
    color: #fff;
    background:
      radial-gradient(90% 80% at 100% 0%, rgb(255 138 43 / 0.55), transparent 60%),
      linear-gradient(160deg, #3b3bd6, #14163f 78%);
  }
  .tone-core .summary {
    color: #dfe0ff;
  }

  .tone-vision {
    color: var(--ink);
    background:
      radial-gradient(80% 70% at 0% 0%, rgb(255 255 255 / 0.55), transparent 60%),
      linear-gradient(155deg, #ffc083, #ff8a2b);
  }
  .tone-vision .points li {
    background: rgb(255 255 255 / 0.4);
    border-color: rgb(255 255 255 / 0.55);
  }

  .tone-glass {
    color: var(--ink);
    background: linear-gradient(140deg, rgb(255 255 255 / 0.86), rgb(255 255 255 / 0.6));
    box-shadow:
      inset 0 1px 0 #fff,
      0 22px 48px -18px rgb(59 59 214 / 0.22);
  }
  .tone-glass .summary {
    color: var(--ink-soft);
  }
  .tone-glass .points li {
    background: rgb(59 59 214 / 0.08);
    border-color: transparent;
    color: var(--core-900);
  }

  .tone-teal {
    color: #fff;
    background:
      radial-gradient(70% 60% at 100% 100%, rgb(25 181 165 / 0.7), transparent 65%),
      linear-gradient(160deg, #0f4f4a, #08272a 80%);
  }
  .tone-teal .summary {
    color: #d3f3ee;
  }

  /* Phones: decorations move to a reserved strip at the top so they never sit under text. */
  @media (max-width: 47.99rem) {
    .cell {
      padding-top: 5.5rem;
    }
    .cell :global(.object) {
      top: 1.25rem !important;
      right: 1.5rem !important;
      bottom: auto !important;
      left: auto !important;
      transform: scale(0.6);
      transform-origin: top right;
    }
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .cell {
      min-height: 22rem;
    }
    .tone-core {
      grid-column: span 7;
    }
    .tone-vision {
      grid-column: span 5;
    }
    .tone-glass {
      grid-column: span 5;
    }
    .tone-teal {
      grid-column: span 7;
    }
  }
</style>
