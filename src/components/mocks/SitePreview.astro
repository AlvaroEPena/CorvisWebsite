---
/**
 * A scrollable preview of a finished portfolio site (hero, services, about, gallery, call to
 * action), composed from the project's real photos and copy. Decorative: the parent hides it from
 * assistive technology and the case summary next to it carries the information.
 * Sizes are em: 1em = 16px of a 1440px-wide page, and the root font-size follows the container
 * width (cqw), so the page scales like a screenshot.
 */
import { Image } from 'astro:assets';
import type { WorkProject } from '../../content/projects';
import { portfolioImage } from './portfolio-images';

interface Props {
  project: WorkProject;
}

const { project } = Astro.props;
const { preview } = project;
const photo = (file: string) => portfolioImage(project.folder, file);
const { theme } = preview;
---

<div
  class="site"
  style={`--ink:${theme.ink};--paper:${theme.paper};--accent:${theme.accent};--accent-soft:${theme.accentSoft}`}
>
  <section class="hero">
    <Image
      class="hero-photo"
      src={photo(preview.heroPhoto)}
      alt=""
      width={1500}
      sizes="720px"
      loading="lazy"
    />
    <header class="top">
      <span class="brand">{preview.brand}</span>
      <span class="menu">
        {preview.nav.map((item) => (
          <span>{item}</span>
        ))}
      </span>
    </header>
    <div class="copy">
      <p class="eyebrow">{preview.eyebrow}</p>
      <h2 class="display">{preview.headline}</h2>
      <p class="subline">{preview.subline}</p>
      <div class="buttons">
        <span class="solid">{preview.primaryCta}</span>
        <span class="outline">{preview.secondaryCta}</span>
      </div>
    </div>
  </section>

  <ul class="strip">
    {preview.strip.map((item) => (
      <li>{item}</li>
    ))}
  </ul>

  <section class="about">
    <div>
      <h2 class="display">{preview.aboutTitle}</h2>
      <p>{preview.aboutText}</p>
    </div>
    <Image src={photo(preview.aboutPhoto)} alt="" width={900} sizes="520px" loading="lazy" />
  </section>

  <section class="services">
    <h2 class="display">{preview.servicesTitle}</h2>
    <div class="cards">
      {preview.services.map((service) => (
        <article>
          <h3 class="display">{service.title}</h3>
          <p>{service.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="gallery">
    <h2 class="display">{preview.galleryTitle}</h2>
    <div class="grid">
      {preview.galleryPhotos.map((file) => (
        <Image src={photo(file)} alt="" width={640} sizes="360px" loading="lazy" />
      ))}
    </div>
  </section>

  <section class="cta">
    <h2 class="display">{preview.ctaTitle}</h2>
    <p>{preview.ctaText}</p>
    <span class="solid">{preview.ctaLabel}</span>
  </section>
</div>

<style>
  .site {
    font-size: 1.1111cqw;
    line-height: 1.5;
    font-family: var(--font-body);
    color: var(--ink);
    background: var(--paper);
  }

  h2,
  h3,
  p,
  ul {
    margin: 0;
    padding: 0;
  }

  /* The finished site sets headings in a light serif; a system serif stands in for it here. */
  .display {
    font-family: Georgia, 'Times New Roman', serif;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .solid,
  .outline {
    display: inline-block;
    padding: 0.95em 1.9em;
    font-size: 0.85em;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    width: fit-content;
  }

  .solid {
    background: var(--accent);
    color: var(--ink);
  }

  .outline {
    border: 1px solid rgb(255 255 255 / 0.7);
    color: #fff;
  }

  .hero {
    position: relative;
    height: 46em;
    color: #fff;
    background: var(--ink);
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
    opacity: 0.62;
  }

  .top {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2em 4em;
    font-size: 0.9em;
  }

  .brand {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.5em;
  }

  .menu {
    display: flex;
    gap: 2.4em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.85em;
  }

  .copy {
    position: absolute;
    left: 4em;
    bottom: 5em;
    display: grid;
    gap: 1.6em;
    max-width: 38em;
  }

  .eyebrow {
    color: var(--accent);
    font-size: 0.85em;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .copy .display {
    font-size: 4.6em;
  }

  .subline {
    font-size: 1.3em;
    opacity: 0.9;
  }

  .buttons {
    display: flex;
    gap: 1em;
  }

  .strip {
    display: flex;
    justify-content: space-between;
    padding: 1.8em 4em;
    list-style: none;
    background: var(--ink);
    color: var(--accent);
    font-size: 0.85em;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .about {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 5em;
    align-items: center;
    padding: 7em 4em;
  }

  .about .display {
    margin-bottom: 1em;
    font-size: 3.4em;
  }

  .about p {
    font-size: 1.2em;
    color: #5b5349;
  }

  .about img {
    width: 100%;
    height: 24em;
    object-fit: cover;
  }

  .services {
    padding: 6em 4em;
    background: var(--accent-soft);
  }

  .services > .display {
    margin-bottom: 1.2em;
    font-size: 3em;
    text-align: center;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.6em;
  }

  article {
    padding: 2em;
    background: var(--paper);
    border-top: 3px solid var(--accent);
  }

  article .display {
    margin-bottom: 0.6em;
    font-size: 1.7em;
  }

  article p {
    font-size: 0.95em;
    color: #5b5349;
  }

  .gallery {
    padding: 7em 4em;
  }

  .gallery > .display {
    margin-bottom: 1.2em;
    font-size: 3em;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.6em;
  }

  .grid img {
    width: 100%;
    height: 26em;
    object-fit: cover;
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: 1.6em;
    padding: 7em 4em;
    background: var(--ink);
    color: #fff;
    text-align: center;
  }

  .cta .display {
    font-size: 3.6em;
  }

  .cta p {
    max-width: 38em;
    font-size: 1.15em;
    opacity: 0.85;
  }
</style>
