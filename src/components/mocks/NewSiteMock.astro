---
/**
 * Decorative recreation of the REBUILT pool-builder site, top to bottom, with the business details
 * replaced by the fictional sample. Shared by the before/after slider and the portfolio showcase.
 * All sizes are em: 1em = 16px of a 1440px-wide page, and the root font-size follows the container
 * width, so the page scales like a screenshot. Water motion is two drifting copies of one still.
 */
import { Image } from 'astro:assets';
import type { RedesignSample } from '../../content/redesign-demo';
import { portfolioImage } from './portfolio-images';

interface Props {
  project: RedesignSample;
}

const { project } = Astro.props;
const { site } = project;
const photo = (file: string) => portfolioImage(project.folder, file);
const waterUrl = `url(${photo('water-01').src})`;
const [big, tall, fire, patio, excavation] = site.services;
const gallery = ['pool-11', 'pool-01', 'pool-07', 'pool-05'];
---

<div class="new site" style={`--water:${waterUrl}`}>
  <section class="hero">
    <div class="water" aria-hidden="true">
      <i class="w1"></i>
      <i class="w2"></i>
    </div>
    <header class="top">
      <span class="logo">
        <b>S</b>ALTWATER<small>{site.descriptor.toUpperCase()}</small>
      </span>
      <span class="menu">
        {site.nav.map((item) => (
          <span>{item}</span>
        ))}
      </span>
      <span class="call">
        <span>{site.phone}</span>
        <span class="orange">{site.cta}</span>
      </span>
    </header>
    <div class="copy">
      <h2 class="display">{site.headline}</h2>
      <p>{site.subline}</p>
      <div class="buttons">
        <span class="orange big">{site.cta}</span>
        <span class="ghost">{site.secondaryCta}</span>
      </div>
    </div>
  </section>

  <section class="about">
    <div class="about-copy">
      <h2 class="display">{site.aboutTitle}</h2>
      <p>{site.aboutText}</p>
      <Image src={photo('pool-01')} alt="" width={900} loading="lazy" />
    </div>
    <dl class="stats">
      {site.stats.map((stat) => (
        <div>
          <dd>{stat.value}</dd>
          <dt>{stat.label}</dt>
        </div>
      ))}
    </dl>
  </section>

  <section class="build">
    <span class="eyebrow">WHAT WE BUILD</span>
    <h2 class="display">{site.servicesTitle}</h2>
    <div class="bento">
      {[big, tall, fire, patio, excavation].map((service, index) =>
        service ? (
          <article class:list={['tile', `t${index}`]}>
            <Image src={photo(service.photo)} alt="" width={760} loading="lazy" />
            <div class="tile-copy">
              <h3>{service.title}</h3>
              <p>{service.text}</p>
              {service.tags && (
                <span class="tags">
                  {service.tags.map((tag) => (
                    <i>{tag}</i>
                  ))}
                </span>
              )}
            </div>
          </article>
        ) : null,
      )}
    </div>
  </section>

  <section class="steps">
    <div class="steps-copy">
      <span class="eyebrow">HOW IT WORKS</span>
      <h2 class="display">{site.stepsTitle}</h2>
      <p>
        One crew, one schedule, five clear moves. When the build is done, we can keep the water
        sparkling.
      </p>
      <span class="ghost">Explore our services</span>
    </div>
    <ol>
      {site.steps.map((step) => (
        <li>
          <i></i>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="gallery">
    <div class="gallery-head">
      <h2 class="display">{site.galleryTitle}</h2>
      <u>See the full gallery</u>
    </div>
    <div class="reel">
      {gallery.map((file) => (
        <Image src={photo(file)} alt="" width={640} loading="lazy" />
      ))}
    </div>
  </section>

  <section class="voices">
    <div class="voices-head">
      <h2 class="display">{site.quotesTitle}</h2>
      <span class="ghost">Prev</span>
      <span class="ghost">Next</span>
    </div>
    <div class="quotes">
      {site.quotes.slice(0, 2).map((item) => (
        <article>
          <p>
            {'“'}
            {item.quote}
            {'”'}
          </p>
          <small>
            <b>{item.name}</b>
          </small>
        </article>
      ))}
    </div>
  </section>

  <section class="pay">
    <div>
      <h2 class="display">{site.paymentTitle}</h2>
      <p>{site.paymentText}</p>
      <span class="ghost">{site.cta}</span>
    </div>
  </section>

  <section class="cta">
    <div class="water" aria-hidden="true">
      <i class="w1"></i>
      <i class="w2"></i>
    </div>
    <div class="cta-copy">
      <h2 class="display">{site.ctaTitle}</h2>
      <p>{site.ctaText}</p>
    </div>
    <div class="buttons">
      <span class="orange big">{site.cta}</span>
      <span class="ghost">Call {site.phone}</span>
    </div>
  </section>

  <footer class="foot">
    <div class="foot-brand">
      <span class="logo">
        <b>S</b>ALTWATER<small>{site.descriptor.toUpperCase()}</small>
      </span>
      <p>{site.headline}</p>
      <span class="orange">{site.cta}</span>
    </div>
    <div>
      <b>EXPLORE</b>
      {site.nav.map((item) => (
        <span>{item}</span>
      ))}
    </div>
    <div>
      <b>VISIT OR CALL</b>
      <span>Serving homeowners across the region</span>
      <span>{site.phone}</span>
      <span>{site.email}</span>
      <span>{site.hours}</span>
    </div>
    <p class="legal">Sample site. Photos are placeholders for concept work.</p>
  </footer>
</div>

<style>
  .site {
    font-size: 1.1111cqw;
    line-height: 1.45;
    font-family: var(--font-body);
    color: #e8f3f8;
    background: #061320;
  }

  h2,
  h3,
  p,
  dl,
  dd,
  dt,
  ol,
  article {
    margin: 0;
    padding: 0;
  }

  .display {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .orange {
    padding: 0.8em 1.5em;
    border-radius: 3em;
    background: #e8793a;
    color: #1a0d05;
    font-size: 0.95em;
    font-weight: 700;
    white-space: nowrap;
    width: fit-content;
  }

  .orange.big {
    padding: 1em 1.8em;
  }

  .ghost {
    padding: 0.8em 1.5em;
    border: 1px solid rgb(232 243 248 / 0.35);
    border-radius: 3em;
    font-size: 0.95em;
    font-weight: 600;
    width: fit-content;
  }

  .buttons {
    display: flex;
    gap: 0.9em;
  }

  .eyebrow {
    color: #35d1e6;
    font-size: 0.78em;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  /* Water: a darkened still plus a second copy drifting slowly over it (transform only). */
  .water {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .water i {
    position: absolute;
    inset: -10%;
    background: var(--water) center / cover;
    filter: hue-rotate(-14deg) saturate(0.8) brightness(0.82) contrast(1.7);
  }

  .water .w2 {
    opacity: 0.5;
    mix-blend-mode: screen;
    transform: scale(1.3) rotate(180deg);
  }

  @keyframes drift-water {
    from {
      transform: scale(1.3) rotate(180deg) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.3) rotate(180deg) translate3d(-6%, 5%, 0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :root:not([data-save-data]) :global(.browse-host[data-in-view]) .water .w2 {
      animation: drift-water 18s ease-in-out infinite alternate;
    }
  }

  .hero {
    position: relative;
    height: 56em;
    overflow: hidden;
  }

  .hero::after,
  .cta::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(4 14 26 / 0.78), rgb(4 14 26 / 0.05) 65%);
  }

  .top {
    position: absolute;
    z-index: 2;
    inset: 1.6em 3em auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    font-size: 0.95em;
    font-weight: 500;
  }

  .logo {
    display: block;
    width: fit-content;
    font-family: var(--font-display);
    font-size: 1.4em;
    letter-spacing: 0.2em;
    line-height: 1.1;
  }

  .logo b {
    display: inline;
    color: #35d1e6;
    font-weight: 700;
  }

  .logo small {
    margin-top: 0.3em;
    color: #35d1e6;
    font-size: 0.4em;
    letter-spacing: 0.35em;
  }

  .menu {
    display: flex;
    gap: 2.2em;
  }

  .call {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.4em;
  }

  .copy {
    position: absolute;
    z-index: 2;
    left: 3em;
    bottom: 8em;
    display: grid;
    gap: 1.5em;
    max-width: 40em;
  }

  .copy .display {
    font-size: 5em;
  }

  .copy p {
    max-width: 26em;
    font-size: 1.1em;
  }

  .about {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 6em;
    padding: 8em 3em 8em;
    border-radius: 50% 50% 0 0 / 2.5em 2.5em 0 0;
    margin-top: -2.4em;
    position: relative;
    z-index: 3;
    background: #061320;
  }

  .about-copy {
    display: grid;
    gap: 1.6em;
  }

  .about .display {
    font-size: 3.9em;
  }

  .about-copy p {
    color: #b9cad4;
    max-width: 34em;
  }

  .about-copy :global(img) {
    width: 100%;
    height: 28em;
    object-fit: cover;
    border-radius: 1.1em;
  }

  .stats {
    display: grid;
    align-content: start;
  }

  .stats div {
    display: grid;
    gap: 0.4em;
    padding: 2em 0 2.4em;
    border-top: 1px solid rgb(232 243 248 / 0.14);
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 4.4em;
    font-weight: 700;
    line-height: 1;
  }

  .stats dt {
    color: #9fb3bf;
    font-size: 0.85em;
  }

  .build {
    display: grid;
    gap: 1.3em;
    padding: 4em 3em 6em;
  }

  .build .display {
    font-size: 3.4em;
  }

  .bento {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 1.1em;
    margin-top: 1.5em;
  }

  .tile {
    position: relative;
    overflow: hidden;
    min-height: 26em;
    border-radius: 1.1em;
    background: #0a1c2c;
  }

  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(4 14 26 / 0.92), rgb(4 14 26 / 0.15) 70%);
  }

  .tile-copy {
    position: absolute;
    z-index: 1;
    inset: auto 1.6em 1.6em;
    display: grid;
    gap: 0.6em;
  }

  .tile h3 {
    font-family: var(--font-display);
    font-size: 1.8em;
    letter-spacing: -0.02em;
  }

  .tile p {
    max-width: 24em;
    font-size: 0.95em;
    color: #d3e2ea;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
  }

  .tags i {
    padding: 0.4em 0.9em;
    border-radius: 2em;
    background: rgb(232 243 248 / 0.14);
    font-size: 0.78em;
    font-style: normal;
    font-weight: 600;
  }

  .t0 {
    grid-row: span 2;
    min-height: 53em;
  }

  .t3,
  .t4 {
    grid-column: auto;
  }

  .steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5em;
    padding: 9em 3em 8em;
    border-radius: 50% 50% 0 0 / 2.5em 2.5em 0 0;
    background: #0a2540;
  }

  .steps-copy {
    display: grid;
    gap: 1.4em;
    align-content: start;
  }

  .steps .display {
    font-size: 3.6em;
  }

  .steps-copy p {
    color: #b9cad4;
    font-size: 1.15em;
  }

  .steps ol {
    display: grid;
    gap: 3em;
    list-style: none;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.2em;
  }

  .steps li i {
    width: 1.4em;
    height: 1.4em;
    margin-top: 0.3em;
    border: 0.25em solid #35d1e6;
    border-radius: 50%;
    background: #061320;
    box-shadow:
      inset 0 0 0 0.2em #061320,
      inset 0 0 0 0.6em #35d1e6;
  }

  .steps h3 {
    font-family: var(--font-display);
    font-size: 1.7em;
  }

  .steps li p {
    color: #b9cad4;
    font-size: 0.95em;
  }

  .gallery {
    display: grid;
    gap: 2.4em;
    padding: 9em 3em 6em;
    border-radius: 50% 50% 0 0 / 2.5em 2.5em 0 0;
    margin-top: -2.4em;
    position: relative;
    background: #061320;
  }

  .gallery-head,
  .voices-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
  }

  .gallery .display,
  .voices .display {
    font-size: 3.4em;
  }

  .gallery-head u {
    color: #35d1e6;
    font-size: 0.95em;
  }

  .reel {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.1em;
  }

  .reel :global(img) {
    width: 100%;
    height: 26em;
    object-fit: cover;
    border-radius: 1.1em;
  }

  .voices {
    display: grid;
    gap: 2.2em;
    padding: 6em 3em 7em;
  }

  .voices-head .ghost {
    margin-left: -0.4em;
  }

  .quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1em;
  }

  .quotes article {
    display: grid;
    gap: 3em;
    align-content: space-between;
    min-height: 17em;
    padding: 2.6em;
    border-radius: 1.1em;
    background: linear-gradient(150deg, #0d3556, #0a2540);
  }

  .quotes p {
    font-family: var(--font-display);
    font-size: 1.7em;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .pay {
    padding: 2em 3em 9em;
  }

  .pay > div {
    display: grid;
    gap: 1.2em;
    padding: 4em;
    border-radius: 1.6em;
    background: linear-gradient(140deg, #0d3b5c, #0a2540);
  }

  .pay .display {
    font-size: 3.2em;
  }

  .pay p {
    max-width: 34em;
    color: #b9cad4;
  }

  .cta {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 3em;
    min-height: 40em;
    padding: 9em 3em 6em;
    overflow: hidden;
  }

  .cta > * {
    position: relative;
    z-index: 2;
  }

  .cta > .water {
    position: absolute;
    z-index: 0;
  }

  .cta-copy {
    display: grid;
    gap: 1.4em;
    max-width: 34em;
  }

  .cta .display {
    font-size: 4em;
  }

  .foot {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.4fr;
    gap: 4em;
    padding: 5em 3em 2.5em;
    background: #0a2540;
    font-size: 0.95em;
    color: #cfdde5;
  }

  .foot > div {
    display: grid;
    gap: 0.6em;
    align-content: start;
  }

  .foot b {
    margin-bottom: 0.6em;
    color: #fff;
    font-size: 0.8em;
    letter-spacing: 0.14em;
  }

  .foot-brand p {
    max-width: 14em;
    margin: 0.8em 0;
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.6em;
    line-height: 1.15;
  }

  .legal {
    grid-column: 1 / -1;
    padding-top: 2em;
    border-top: 1px solid rgb(232 243 248 / 0.12);
    font-size: 0.8em;
  }
</style>
