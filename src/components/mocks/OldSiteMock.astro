---
/**
 * Decorative recreation of the ORIGINAL (dated) pool-builder site, top to bottom, with the business
 * details replaced by the fictional sample. All sizes are em: 1em = 16px of a 1440px-wide page, and
 * the root font-size is tied to the container width, so the whole page scales like a screenshot.
 */
import { Image } from 'astro:assets';
import type { Project } from '../../content/projects';
import { portfolioImage } from './portfolio-images';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { site } = project;
const photo = (file: string) => portfolioImage(project.folder, file);
const water = photo('water-01');
const carousel = ['pool-03', 'pool-01', 'pool-10'];
const cards = [site.services[0], site.services[1]];
const cardPhotos = ['pool-04', 'pool-09'];
---

<div class="old site">
  <section class="hero" style={`--water:url(${water.src})`}>
    <nav class="nav">
      <span class="links">
        {site.old.nav.map((item, index) => (
          <span class:list={[index === 0 && 'on']}>{item}</span>
        ))}
      </span>
      <span class="social">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="login">Client Login</span>
    </nav>
    <div class="lockup">
      <svg class="mark" viewBox="0 0 160 190" aria-hidden="true" focusable="false">
        <path
          d="M118 26C58 14 30 52 62 82c34 30 74 40 40 82-14 14-40 18-62 8"
          fill="none"
          stroke="rgba(214,226,238,.78)"
          stroke-width="30"
          stroke-linecap="butt"
        ></path>
      </svg>
      <p class="headline">
        {site.old.headline.map((line) => (
          <span>{line}</span>
        ))}
      </p>
    </div>
  </section>

  <section class="what">
    <h2>{site.old.whatWeDoTitle}</h2>
    <p class="lead">{site.old.whatWeDoLead}</p>
    <p class="text">{site.old.whatWeDoText}</p>
  </section>

  <section class="cards">
    <div class="pair">
      {cards.map((card, index) => (
        <figure>
          <Image src={photo(cardPhotos[index] ?? 'pool-04')} alt="" width={640} loading="lazy" />
          <h3>{card?.title.toUpperCase()}</h3>
          <p>{card?.text}</p>
        </figure>
      ))}
    </div>
    <span class="pill blue">{site.old.estimateCta}</span>
  </section>

  <section class="featured">
    <h2>FEATURED IN</h2>
    <div class="logos">
      <i></i>
      <i></i>
      <i></i>
      <i></i>
      <i></i>
    </div>
    <div class="photos">
      {carousel.map((file) => (
        <Image src={photo(file)} alt="" width={420} loading="lazy" />
      ))}
    </div>
  </section>

  <section class="reviews">
    <h2>{site.old.reviewsTitle}</h2>
    <div class="grid">
      {site.quotes.map((item) => (
        <blockquote>
          <b>{item.title.toUpperCase()}</b>
          <p>
            {'“'}
            {item.quote}
            {'”'}
          </p>
          <small>
            {'- '}
            {item.name}
          </small>
        </blockquote>
      ))}
    </div>
    <span class="pill navy">{site.old.moreReviews}</span>
  </section>

  <section class="band" style={`--water:url(${water.src})`}>
    <Image src={photo('pool-08')} alt="" width={900} loading="lazy" />
    <p>
      {site.old.bandLines.map((line) => (
        <span>{line}</span>
      ))}
    </p>
  </section>

  <footer class="foot">
    <div class="who">
      <b>{site.brand.toUpperCase()}, LLC</b>
      <p>{site.old.footerLine}</p>
      <p>
        <u>{site.email}</u> &nbsp;|&nbsp; <u>{site.phone}</u>
      </p>
    </div>
    <div class="hours">
      <b>Hours</b>
      <i>Monday - Friday</i>
      <span>9:00 am - 5:00 pm</span>
    </div>
    <div class="follow">
      <b>Follow</b>
      <span class="social grey">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </div>
    <p class="copy">Copyright 2021 {site.brand} LLC</p>
  </footer>
</div>

<style>
  .site {
    font-size: 1.1111cqw;
    line-height: 1.4;
    font-family: 'Segoe UI', 'Trebuchet MS', Arial, sans-serif;
    color: #0b2a4a;
    background: #fff;
  }

  h2,
  h3,
  p,
  figure,
  blockquote {
    margin: 0;
  }

  /* Hero: full-bleed pool water, big translucent mark, stacked headline. */
  .hero {
    position: relative;
    height: 56.25em;
    background: var(--water) center / cover #0b72c8;
    color: #fff;
  }

  .nav {
    position: absolute;
    inset: 2em 3em auto 3em;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.6em;
    font-size: 1.1em;
  }

  .links {
    display: flex;
    gap: 1.4em;
    text-shadow: 0 1px 3px rgb(0 40 90 / 0.5);
  }

  .links .on {
    border-bottom: 2px solid #fff;
  }

  .social {
    display: flex;
    gap: 1em;
  }

  .social i {
    width: 0.9em;
    height: 0.9em;
    border-radius: 50%;
    background: #fff;
  }

  .social.grey i {
    width: 2em;
    height: 2em;
    background: #dbe3ea;
  }

  .login {
    padding: 1em 1.8em;
    border-radius: 3em;
    background: #fff;
    color: #0b2a4a;
    font-size: 0.95em;
  }

  .lockup {
    position: absolute;
    inset: 9em 0 0;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 1.5em;
  }

  .mark {
    width: 12em;
    filter: drop-shadow(0 0.4em 0.6em rgb(0 40 90 / 0.35));
  }

  .headline {
    display: grid;
    gap: 0.35em;
    text-align: center;
    font-size: 2.7em;
    font-weight: 300;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }

  .headline span:last-child {
    font-weight: 800;
  }

  .what {
    display: grid;
    justify-items: center;
    gap: 1.2em;
    padding: 5em 20em 4.5em;
    background: #003259;
    color: #fff;
    text-align: center;
  }

  .what h2 {
    color: #4da3f0;
    font-size: 2.6em;
    letter-spacing: 0.08em;
  }

  .what .lead {
    font-size: 1.4em;
    letter-spacing: 0.03em;
  }

  .what .text {
    font-size: 1.05em;
  }

  .cards {
    display: grid;
    justify-items: center;
    gap: 3em;
    padding: 4em 4.5em 4em;
    background: #dde6ee;
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3em;
    width: 100%;
  }

  figure {
    display: grid;
    gap: 1em;
    text-align: center;
  }

  figure :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  figure h3 {
    color: #0f5fb0;
    font-size: 1.5em;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  figure p {
    font-size: 0.95em;
  }

  .pill {
    padding: 1.1em 2.4em;
    border-radius: 3em;
    font-size: 1.05em;
    font-weight: 600;
  }

  .blue {
    background: #1472c6;
    color: #fff;
  }

  .navy {
    background: #003259;
    color: #fff;
  }

  .featured {
    display: grid;
    gap: 2.5em;
    padding: 4em 2.5em 4em;
    text-align: center;
    background: #fff;
  }

  .featured h2 {
    font-size: 2.4em;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: #123a63;
  }

  /* Press logos are intentionally blank: this recreation carries no real third-party marks. */
  .logos {
    display: flex;
    justify-content: center;
    gap: 3em;
  }

  .logos i {
    width: 9em;
    height: 4em;
    border-radius: 0.5em;
    background: #e3e8ee;
  }

  .photos {
    display: grid;
    grid-template-columns: 1fr 1.25fr 1.25fr;
    gap: 0;
    height: 40em;
  }

  .photos :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reviews {
    display: grid;
    justify-items: center;
    gap: 2.5em;
    padding: 4.5em 2.5em;
    background:
      radial-gradient(60% 50% at 20% 30%, rgb(255 255 255 / 0.7), transparent),
      radial-gradient(50% 60% at 80% 70%, rgb(200 208 214 / 0.6), transparent), #e4e8eb;
  }

  .reviews h2 {
    color: #123a63;
    font-size: 2.4em;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5em;
    width: 100%;
  }

  blockquote {
    display: grid;
    gap: 1.4em;
    align-content: start;
    padding: 2em 2.6em;
    min-height: 15em;
    background: #23517a;
    color: #fff;
    text-align: center;
    font-size: 0.95em;
  }

  blockquote b {
    font-size: 1.45em;
    font-weight: 400;
    letter-spacing: 0.08em;
  }

  .band {
    display: grid;
    justify-items: center;
    gap: 3em;
    padding: 4em 8em 5em;
    background: var(--water) center / cover #0b72c8;
    color: #fff;
    text-align: center;
  }

  .band :global(img) {
    width: 100%;
    height: 13em;
    object-fit: cover;
  }

  .band p {
    display: grid;
    gap: 0.4em;
    font-size: 2.3em;
    font-weight: 300;
    letter-spacing: 0.05em;
  }

  .foot {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 4em;
    padding: 4em 2.5em 2em;
    background: #fff;
    color: #123a63;
    font-size: 1.05em;
  }

  .who b,
  .hours b,
  .follow b {
    display: block;
    margin-bottom: 1em;
    letter-spacing: 0.05em;
  }

  .who b {
    font-size: 1.15em;
  }

  .hours i {
    display: block;
  }

  .copy {
    grid-column: 1 / -1;
    margin-top: 2em;
    text-align: center;
    font-size: 0.8em;
  }
</style>
