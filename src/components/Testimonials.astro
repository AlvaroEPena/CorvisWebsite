---
import { testimonials } from '../content/testimonials';

const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
---

<section
  class="testimonials section"
  id="testimonials"
  aria-labelledby="testimonials-title"
  data-testid="testimonials"
>
  <div class="aura" style="--aura-color:rgb(255 192 131 / .42);bottom:-8rem;right:-20rem"></div>
  <div class="container">
    <div class="section-heading reveal">
      <h2 id="testimonials-title">What working with us feels like.</h2>
      <p class="sample-note" data-testid="testimonials-sample-note">
        Sample feedback shown as a preview. Real client quotes replace these at launch.
      </p>
    </div>

    <div class="layout">
      {testimonials.map((item, index) => (
        <figure
          class:list={['quote', 'panel', 'reveal', index === 0 && 'lead', index === 2 && 'shift']}
          data-placeholder={item.placeholder}
        >
          <blockquote>
            <p>&ldquo;{item.quote}&rdquo;</p>
          </blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">
              {initials(item.name)}
            </span>
            <span>
              <strong>{item.name}</strong>
              <span class="role">
                {item.role}, {item.company}
              </span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .sample-note {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--ink-soft, rgb(14 16 36 / 0.7));
    font-style: italic;
  }

  .layout {
    display: grid;
    gap: 1.25rem;
  }

  .quote {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    margin: 0;
    padding: clamp(1.6rem, 3vw, 2.5rem);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .lead blockquote p {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.18;
    letter-spacing: -0.03em;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  figcaption > span:last-child {
    display: grid;
    line-height: 1.3;
  }

  .role {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: linear-gradient(145deg, #7c7cff, #14163f);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .shift .avatar {
    background: linear-gradient(145deg, #ffc083, #c2410a);
  }

  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .lead {
      grid-column: 1 / span 7;
      grid-row: span 2;
    }
    .quote:not(.lead) {
      grid-column: span 5;
    }
  }
</style>
