---
import { site } from '../content/site';
import { teamProfiles, teamTeaser } from '../content/team';
import { getHomeReviews, initialsOf } from '../lib/reviews';
import { teamImages } from '../lib/team-photos';
import AvatarStack from './AvatarStack.astro';
import Monogram from './Monogram.astro';

const reviews = getHomeReviews();
const founders = site.team.map(({ id }) => ({
  id,
  images: teamImages(id),
  monogram: teamProfiles.find((profile) => profile.id === id)?.monogram ?? '',
}));
---

<section
  class="testimonials section"
  id="testimonials"
  aria-labelledby="testimonials-title"
  data-testid="testimonials"
>
  <div class="aura" style="--aura-color:rgb(255 192 131 / .42);bottom:-8rem;right:-20rem"></div>
  <div class="container">
    <div class="section-heading reveal">
      <h2 id="testimonials-title">What working with us feels like.</h2>
    </div>

    <div class="layout">
      {reviews.map((item, index) => (
        <figure class:list={['quote', 'panel', 'reveal', index === 0 && 'lead']}>
          <blockquote>
            <p>&ldquo;{item.quote}&rdquo;</p>
          </blockquote>
          <figcaption>
            <Monogram initials={initialsOf(item.name)} tone={index % 2 === 0 ? 'core' : 'vision'} />
            <span>
              <strong>{item.name}</strong>
              <span class="role">
                {item.role}, {item.company}
              </span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="more reveal">
      <a
        class="btn btn-primary btn-shine team-cta"
        href={teamTeaser.href}
        data-magnetic
        data-testid="meet-the-team"
      >
        <AvatarStack people={founders} />
        <span class="team-text">
          <strong>{teamTeaser.label}</strong>
          <span>{teamTeaser.text}</span>
        </span>
        <svg class="btn-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4 10h11m-4-5 5 5-5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
      <a class="btn btn-glass btn-shine" href="/reviews" data-magnetic data-testid="more-reviews">
        More reviews
        <svg class="btn-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4 10h11m-4-5 5 5-5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 1.25rem;
  }

  .quote {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    margin: 0;
    padding: clamp(1.6rem, 3vw, 2.5rem);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .lead blockquote p {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  figcaption > span:last-child {
    display: grid;
    line-height: 1.3;
  }

  .role {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  /* Two calls to action: the team banner is the main one, "More reviews" the quieter pill. */
  .more {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.9rem;
    max-width: 28rem;
    margin: clamp(1.75rem, 3vw, 2.5rem) auto 0;
  }

  .team-cta {
    justify-content: flex-start;
    gap: 0.9rem;
    min-height: 4.5rem;
    padding: 0.7rem 1.4rem 0.7rem 0.8rem;
    white-space: normal;
    text-align: left;
  }

  .team-text {
    display: grid;
    flex: 1;
    gap: 0.15rem;
    line-height: 1.25;
  }

  .team-text strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }

  .team-text span {
    color: rgb(255 255 255 / 0.82);
    font-size: 0.9rem;
    font-weight: 500;
  }

  @media (min-width: 40rem) {
    .more {
      flex-direction: row;
      align-items: center;
      justify-content: center;
      gap: 1.1rem;
      max-width: none;
    }

    .team-cta {
      padding-right: 1.8rem;
    }
  }

  /* Rows of 7+5 and 5+7 columns, so one to six reviews all sit in a balanced grid. */
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .quote {
      grid-column: span 5;
    }
    .quote:nth-child(4n + 1),
    .quote:nth-child(4n) {
      grid-column: span 7;
    }
    .quote:nth-child(4n + 3):last-child,
    .quote:only-child {
      grid-column: 1 / -1;
    }
  }
</style>
