---
import { getFeaturedReviews, initialsOf } from '../lib/reviews';
import Monogram from './Monogram.astro';

const reviews = getFeaturedReviews();
---

<section
  class="testimonials section"
  id="testimonials"
  aria-labelledby="testimonials-title"
  data-testid="testimonials"
>
  <div class="aura" style="--aura-color:rgb(255 192 131 / .42);bottom:-8rem;right:-20rem"></div>
  <div class="container">
    <div class="section-heading reveal">
      <h2 id="testimonials-title">What working with us feels like.</h2>
    </div>

    <div class="layout">
      {reviews.map((item, index) => (
        <figure class:list={['quote', 'panel', 'reveal', index === 0 && 'lead']}>
          <blockquote>
            <p>&ldquo;{item.quote}&rdquo;</p>
          </blockquote>
          <figcaption>
            <Monogram initials={initialsOf(item.name)} tone={index % 2 === 0 ? 'core' : 'vision'} />
            <span>
              <strong>{item.name}</strong>
              <span class="role">
                {item.role}, {item.company}
              </span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="more reveal">
      <a class="btn btn-glass btn-shine" href="/reviews" data-magnetic data-testid="more-reviews">
        More reviews
        <svg class="btn-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4 10h11m-4-5 5 5-5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 1.25rem;
  }

  .quote {
    display: grid;
    align-content: space-between;
    gap: 2rem;
    margin: 0;
    padding: clamp(1.6rem, 3vw, 2.5rem);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .lead blockquote p {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  figcaption > span:last-child {
    display: grid;
    line-height: 1.3;
  }

  .role {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .more {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.75rem, 3vw, 2.5rem);
  }

  /* Rows of 7+5 and 5+7 columns, so one to six reviews all sit in a balanced grid. */
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .quote {
      grid-column: span 5;
    }
    .quote:nth-child(4n + 1),
    .quote:nth-child(4n) {
      grid-column: span 7;
    }
    .quote:nth-child(4n + 3):last-child,
    .quote:only-child {
      grid-column: 1 / -1;
    }
  }
</style>
