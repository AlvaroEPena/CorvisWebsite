---
import { getSandboxProject } from '../content/sandbox';
import { demoPageUrl } from '../scripts/sandbox-frames';
import PreviewLoading from './PreviewLoading.astro';

/**
 * One real demo site (the same build the /sandbox shows) inside a fixed box. From the first paint the
 * box holds the "Preview Loading" placeholder; scripts/live-browse.ts mounts the decorative iframe
 * (hidden, same box) when the host (`[data-live-host]`) is near the viewport, then cross-fades it
 * over the placeholder once it is ready. Nothing changes size or position when it arrives. If the
 * demo cannot load, or Save-Data is on, the placeholder stays in its calm "Preview unavailable" state.
 */
interface Props {
  projectId: string;
  version: 'before' | 'after';
  /** Fills a positioned parent (the slider layers); otherwise the box takes `aspect-ratio` from CSS. */
  fill?: boolean;
  /** Shows the wheel and words in the placeholder (default). */
  status?: boolean;
}

const { projectId, version, fill = false, status = true } = Astro.props;
const entry = getSandboxProject(projectId)?.versions[version];
if (!entry) throw new Error(`No ${version} demo registered for "${projectId}"`);
---

<div
  class:list={['live-stage', fill && 'live-fill']}
  data-live-stage
  data-live-state="loading"
  data-src={demoPageUrl(entry.src)}
  data-title={entry.title}
>
  <PreviewLoading status={status} />
</div>

<script>
  import '../scripts/live-browse';
</script>

<style is:global>
  .live-stage {
    position: relative;
    display: block;
    overflow: hidden;
    /* Painted on its own layer: the page scrolling inside never repaints the page around it. */
    contain: paint;
  }

  /*
   * A see-through shield over the demo. Some phones let a finger drag the iframe's own page even with
   * pointer-events: none on it, so the preview never takes a touch: this layer does, and it only allows
   * normal page scrolling and pinch zoom. Swiping across a preview just scrolls the page.
   */
  .live-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    touch-action: pan-y pinch-zoom;
  }

  .live-fill {
    position: absolute;
    inset: 0;
  }

  /*
   * The demo is a fixed 1440px wide desktop layout scaled to the stage with a transform. It is mounted
   * hidden in the same box and only ever changes opacity. pointer-events: none keeps the slider above it
   * usable.
   */
  .live-frame {
    position: absolute;
    left: 0;
    top: 0;
    width: 1440px;
    height: var(--live-height, 900px);
    border: 0;
    background: #fff;
    transform-origin: 0 0;
    transform: translate3d(0, 0, 0) scale(var(--live-scale, 1));
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }

  /* The cross-fade: the site comes in as the placeholder goes out, with the same timing. */
  .live-frame,
  .live-stage > .preview-loading {
    transition: opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .live-stage[data-live-ready] .live-frame {
    opacity: 1;
  }

  .live-stage[data-live-ready] > .preview-loading {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 0.5s;
  }
</style>
