---
import { proofChips, proofStats } from '../content/proof';
---

<section class="proof" id="proof" aria-label="What we build to">
  <div class="container">
    <div class="strip glass" data-testid="proof">
      <dl class="stats">
        {proofStats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="chips">
        {proofChips.map((chip) => (
          <li>{chip}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .proof {
    position: relative;
    padding-bottom: var(--section-pad);
  }

  .strip {
    display: grid;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.25rem);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 1.5rem;
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  dt {
    max-width: 14rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .chips li {
    padding: 0.45rem 1rem;
    border-radius: var(--radius-pill);
    background: rgb(59 59 214 / 0.08);
    color: var(--core-900);
    font-size: 0.9rem;
    font-weight: 500;
  }

  @media (min-width: 64rem) {
    .stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
