---
import { servicePages } from '../content/service-pages';
import { site } from '../content/site';
import { resolveHref } from '../lib/links';
import Logo from './Logo.astro';

interface Props {
  isHome: boolean;
}
const { isHome } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="top">
      <div class="about">
        <a
          class="glass-tile-host brand"
          href={isHome ? '#main' : '/'}
          aria-label={`${site.name} home`}
        >
          <Logo />
        </a>
        <p>{site.slogan}. Websites built around the one idea that makes your business different.</p>
        <a class="mail" href={`mailto:${site.email}`}>
          {site.email}
        </a>
        <a class="mail" href={`tel:${site.phoneE164}`}>
          {site.phone}
        </a>
      </div>
      <nav aria-label="Footer">
        <ul>
          {site.footerNavigation.map((link) => (
            <li>
              <a href={resolveHref(link.href, isHome)}>{link.label}</a>
            </li>
          ))}
          <li>
            <a href={resolveHref(site.cta.href, isHome)}>Contact</a>
          </li>
        </ul>
      </nav>
    </div>
    <div class="meta">
      <p class="coverage" data-testid="footer-coverage">
        {site.coverage.summary} Recent work: {site.coverage.cities.join(', ')}.
      </p>
      <p class="owner">
        {site.team.map((member, index) => (
          <>
            {index > 0 && ' · '}
            <span>
              {member.name}, {member.role}
            </span>
          </>
        ))}
      </p>
      <nav aria-label="Services" class="services">
        <ul>
          {servicePages.map((page) => (
            <li>
              <a href={`/services/${page.slug}`}>{page.name}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="bottom">
      <p>
        &copy; {year} {site.name}. All rights reserved.
      </p>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: 4rem 2.5rem;
    border-top: 1px solid var(--line);
  }

  .top {
    display: grid;
    gap: 2.5rem;
    padding-bottom: 1.5rem;
  }

  /* Full-width details under the columns: where we work, who we are, and the service pages. */
  .meta {
    display: grid;
    gap: 0.35rem;
    padding-bottom: 1rem;
    color: var(--ink-soft);
  }

  .about {
    display: grid;
    gap: 1rem;
    max-width: 24rem;
    color: var(--ink-soft);
  }

  .brand {
    display: inline-flex;
    width: fit-content;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }

  .coverage,
  .owner {
    margin: 0;
    font-size: 0.875rem;
  }

  .services ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2rem;
  }

  .mail {
    width: fit-content;
    color: var(--core-600);
    font-weight: 600;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.25rem 2rem;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--ink-soft);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--ink-mute);
    font-size: 0.9rem;
  }

  .bottom a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  @media (min-width: 48rem) {
    .top {
      grid-template-columns: 1fr auto;
    }
    nav:not(.services) ul {
      grid-template-columns: repeat(3, auto);
    }
  }

  /* Wide enough for each line to sit on one line. */
  @media (min-width: 72rem) {
    .coverage,
    .owner {
      white-space: nowrap;
    }
  }
</style>
