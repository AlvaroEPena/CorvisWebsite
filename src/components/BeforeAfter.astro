---
import { getSandboxProject } from '../content/sandbox';
import { sandboxCta } from '../content/sandbox-copy';
import { describePosition } from '../scripts/slider-math';
import LiveSiteStage from './LiveSiteStage.astro';
import PreviewLoading from './PreviewLoading.astro';

const START = 50;
/** The registry project whose real builds are shown live (the same as /sandbox). */
const LIVE_PROJECT = 'saltwater-row';
const displayUrl = getSandboxProject(LIVE_PROJECT)?.displayUrl ?? '';
---

<section class="redesign section" id="redesign" aria-labelledby="redesign-title">
  <div class="aura" style="--aura-color:rgb(255 192 131 / .5);top:-10rem;left:30%"></div>
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">Before and after</p>
      <h2 id="redesign-title">A real before and after.</h2>
      <p>
        A dated site on the left, the rebuild on the right. Drag the handle, or focus it and use the
        arrow keys. A sample project with the details changed, and you can test drive both versions
        for real in the sandbox.
      </p>
    </div>

    <div
      class="frame panel"
      data-live-host
      data-browse-duration="80"
      data-ba
      data-testid="redesign-slider"
      style={`--ba-pos:${START}%`}
    >
      <div class="window">
        <!-- Decorative browser chrome: the wipe starts below it. -->
        <div class="chrome" aria-hidden="true">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="address">{displayUrl}</span>
        </div>
        <div class="stage-wrap">
          <div class="stage" aria-hidden="true">
            <!-- AFTER: the rebuilt site, always underneath. -->
            <div class="layer after">
              <LiveSiteStage projectId={LIVE_PROJECT} version="after" fill status={false} />
            </div>

            <!-- BEFORE: the dated site, in a box as wide as the left of the handle. Its page is as wide
                 as the whole stage (100cqw) and never changes size; only the window onto it does. -->
            <div class="layer before" data-ba-before style={`width:${START}%`}>
              <LiveSiteStage projectId={LIVE_PROJECT} version="before" fill status={false} />
            </div>

            <!-- One "Preview Loading" for the whole stage, above both panels and clear of the handle's knob. -->
            <div class="stage-status">
              <PreviewLoading panel={false} />
            </div>

            <span class="tag tag-before">Before</span>
            <span class="tag tag-after">After</span>
            <span class="handle">
              <span class="knob"></span>
            </span>
          </div>

          <label class="sr-only" for="ba-range">
            Compare the original site with the rebuilt site. Use the left and right arrow keys.
          </label>
          <input
            id="ba-range"
            class="range"
            type="range"
            min="0"
            max="100"
            step="1"
            value={START}
            aria-valuetext={describePosition(START)}
            data-ba-input
          />
        </div>
      </div>
    </div>

    <div class="explore reveal">
      <a
        class="btn btn-glass btn-shine"
        href={sandboxCta.href}
        data-magnetic
        data-testid="explore-sandbox"
      >
        {sandboxCta.label}
        <svg class="btn-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4 10h11m-4-5 5 5-5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  import '../scripts/slider';
</script>

<style>
  .explore {
    display: flex;
    justify-content: center;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .frame {
    position: relative;
    padding: clamp(0.5rem, 1.2vw, 0.9rem);
    border-radius: 36px;
  }

  /* A fake browser window: chrome on top, the before/after stage below it. */
  .window {
    overflow: hidden;
    border-radius: 26px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(20 22 63 / 0.08);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem;
    background: linear-gradient(180deg, #f6f6fc, #ecebf5);
    border-bottom: 1px solid rgb(20 22 63 / 0.08);
  }

  /* The same red, yellow and green lights as the sandbox's browser frame. */
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #ff6b5e;
  }

  .dot:nth-child(2) {
    background: #f6bd3a;
  }

  .dot:nth-child(3) {
    background: #3fc556;
  }

  .address {
    flex: 1;
    min-width: 0;
    margin-left: 0.6rem;
    padding: 0.2rem 0.8rem;
    overflow: hidden;
    border-radius: 99px;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(20 22 63 / 0.1);
    color: var(--ink-mute);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The range thumb is 100vh tall so a touch anywhere on the stage drags it; clip it to the stage
     so it cannot cover the controls below, and so the handle starts under the browser chrome. */
  .stage-wrap {
    position: relative;
    overflow: clip;
  }

  .stage {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #fff;
    user-select: none;
  }

  @media (min-width: 48rem) {
    .stage {
      aspect-ratio: 16 / 9;
    }
  }

  .layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
    contain: paint;
  }

  /* The wipe changes the width of this window only; the page inside keeps its full size. */
  .before {
    z-index: 1;
    right: auto;
    width: var(--ba-pos);
  }

  /* While loading, the wheel and words sit in the upper part of the stage, clear of the handle's knob. */
  .stage-status {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 1;
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 0s;
  }

  .stage-status :global(.preview-loading) {
    place-content: start center;
    padding-top: 14cqw;
  }

  /* It fades out with the After page fading in, with the same timing. */
  .stage:has(.after [data-live-ready]) .stage-status {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s 0.5s;
  }

  /* If the demo cannot load, say so calmly (no wheel). */
  .stage:has(.after [data-live-state='unavailable']) .stage-status :global(.preview-text-loading),
  .stage:has(.after [data-live-state='unavailable']) .stage-status :global(.preview-wheel-wrap) {
    display: none;
  }

  .stage:has(.after [data-live-state='unavailable'])
    .stage-status
    :global(.preview-text-unavailable) {
    display: block;
    color: var(--ink-soft);
  }

  @media (max-width: 47.99rem) {
    .stage-status :global(.preview-loading) {
      padding-top: 5cqw;
    }
    .stage-status :global(.preview-wheel-wrap) {
      width: 3rem;
    }
    .stage-status :global(.preview-wheel) {
      width: 2.4rem;
    }
    .stage-status :global(.preview-status) {
      gap: 0.5rem;
    }
    .stage-status :global(.preview-text) {
      font-size: 0.85rem;
    }
  }

  .before :global(.live-stage) {
    right: auto;
    width: 100cqw;
  }

  /* ---------- Controls ---------- */
  .tag {
    position: absolute;
    top: 1.6cqw;
    z-index: 3;
    padding: 0.6cqw 1.8cqw;
    border-radius: 99cqw;
    background: rgb(14 16 36 / 0.86);
    color: #fff;
    font-family: var(--font-body);
    font-size: max(0.75rem, 1.5cqw);
    font-weight: 600;
  }

  .tag-before {
    left: 1.6cqw;
    top: auto;
    bottom: 5cqw;
  }

  .tag-after {
    right: 1.6cqw;
    bottom: 1.6cqw;
    top: auto;
  }

  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--ba-pos);
    z-index: 4;
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(14 16 36 / 0.25);
  }

  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3rem;
    height: 3rem;
    margin: -1.5rem 0 0 -1.5rem;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 8px 20px -6px rgb(14 16 36 / 0.5),
      inset 0 0 0 1px rgb(14 16 36 / 0.12);
  }

  .knob::before,
  .knob::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: -0.275rem;
    border: solid #14163f;
    border-width: 0 0 2.5px 2.5px;
  }

  .knob::before {
    left: 0.85rem;
    transform: rotate(45deg);
  }

  .knob::after {
    right: 0.85rem;
    transform: rotate(-135deg);
  }

  .frame:has(.range:focus-visible) .knob {
    outline: 3px solid var(--core-600);
    outline-offset: 3px;
  }

  /* The native range input is the real control: transparent, over the whole stage. */
  .range {
    position: absolute;
    inset: 0;
    z-index: 5;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }

  .range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 3rem;
    height: 100vh;
  }

  .range::-moz-range-thumb {
    width: 3rem;
    height: 100vh;
    border: 0;
  }
</style>
