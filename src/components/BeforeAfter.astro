---
import { projects } from '../content/projects';
import { describePosition } from '../scripts/slider-math';
import NewSiteMock from './mocks/NewSiteMock.astro';
import OldSiteMock from './mocks/OldSiteMock.astro';

const START = 50;
const project = projects[0];
if (!project) throw new Error('The redesign demo needs at least one project');
---

<section class="redesign section" id="redesign" aria-labelledby="redesign-title">
  <div class="aura" style="--aura-color:rgb(255 192 131 / .5);top:-10rem;left:30%"></div>
  <div class="container">
    <div class="section-heading reveal">
      <p class="eyebrow">Before and after</p>
      <h2 id="redesign-title">A real before and after.</h2>
      <p>
        A dated site on the left, the rebuild on the right. Drag the handle, or focus it and use the
        arrow keys. A sample project with the details changed.
      </p>
    </div>

    <div
      class="frame panel browse-host"
      data-ba
      data-testid="redesign-slider"
      style={`--ba-pos:${START}%;--browse-duration:80s`}
    >
      <div class="stage" aria-hidden="true">
        <!-- AFTER: the rebuilt site, always underneath. -->
        <div class="layer after">
          <div class="browse">
            <div class="browse-track">
              <NewSiteMock project={project} />
            </div>
          </div>
        </div>

        <!-- BEFORE: the dated site, clipped to the left of the handle. -->
        <div class="layer before" data-ba-before style={`clip-path:inset(0 ${100 - START}% 0 0)`}>
          <div class="browse">
            <div class="browse-track">
              <OldSiteMock project={project} />
            </div>
          </div>
        </div>

        <span class="tag tag-before">Before</span>
        <span class="tag tag-after">After</span>
        <span class="handle">
          <span class="knob"></span>
        </span>
      </div>

      <label class="sr-only" for="ba-range">
        Compare the original site with the rebuilt site. Use the left and right arrow keys.
      </label>
      <input
        id="ba-range"
        class="range"
        type="range"
        min="0"
        max="100"
        step="1"
        value={START}
        aria-valuetext={describePosition(START)}
        data-ba-input
      />
    </div>
  </div>
</section>

<script>
  import '../scripts/slider';
</script>

<style>
  .frame {
    position: relative;
    padding: clamp(0.5rem, 1.2vw, 0.9rem);
    border-radius: 36px;
  }

  .stage {
    position: relative;
    container-type: inline-size;
    aspect-ratio: 4 / 3;
    border-radius: 26px;
    overflow: hidden;
    background: #fff;
    user-select: none;
  }

  @media (min-width: 48rem) {
    .stage {
      aspect-ratio: 16 / 9;
    }
  }

  .layer {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .layer > .browse {
    position: absolute;
    inset: 0;
  }

  .before {
    z-index: 1;
  }

  /* ---------- Controls ---------- */
  .tag {
    position: absolute;
    top: 1.6cqw;
    z-index: 3;
    padding: 0.6cqw 1.8cqw;
    border-radius: 99cqw;
    background: rgb(14 16 36 / 0.86);
    color: #fff;
    font-family: var(--font-body);
    font-size: max(0.75rem, 1.5cqw);
    font-weight: 600;
  }

  .tag-before {
    left: 1.6cqw;
    top: auto;
    bottom: 5cqw;
  }

  .tag-after {
    right: 1.6cqw;
    bottom: 1.6cqw;
    top: auto;
  }

  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--ba-pos);
    z-index: 4;
    width: 3px;
    margin-left: -1.5px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(14 16 36 / 0.25);
  }

  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 3rem;
    height: 3rem;
    margin: -1.5rem 0 0 -1.5rem;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 8px 20px -6px rgb(14 16 36 / 0.5),
      inset 0 0 0 1px rgb(14 16 36 / 0.12);
  }

  .knob::before,
  .knob::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    margin-top: -0.275rem;
    border: solid #14163f;
    border-width: 0 0 2.5px 2.5px;
  }

  .knob::before {
    left: 0.85rem;
    transform: rotate(45deg);
  }

  .knob::after {
    right: 0.85rem;
    transform: rotate(-135deg);
  }

  .frame:has(.range:focus-visible) .knob {
    outline: 3px solid var(--core-600);
    outline-offset: 3px;
  }

  /* The native range input is the real control: transparent, over the whole stage. */
  .range {
    position: absolute;
    inset: clamp(0.5rem, 1.2vw, 0.9rem);
    z-index: 5;
    width: calc(100% - 2 * clamp(0.5rem, 1.2vw, 0.9rem));
    height: calc(100% - 2 * clamp(0.5rem, 1.2vw, 0.9rem));
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    touch-action: pan-y;
    -webkit-appearance: none;
    appearance: none;
  }

  .range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 3rem;
    height: 100vh;
  }

  .range::-moz-range-thumb {
    width: 3rem;
    height: 100vh;
    border: 0;
  }
</style>
