---
import markSource from '../assets/brand/corvis-mark.svg?raw';
import { site } from '../content/site';
import { MARK_PALETTES, type MarkVariant, paintMark, parseMark } from '../lib/brand-mark';

interface Props {
  /** Visible wordmark next to the mark. */
  showName?: boolean;
  /** `light` repaints the mark for dark surfaces (and uses the dark glass tile). */
  variant?: MarkVariant;
  /** `lg` is the large decorative mark used on the 404 and thank-you pages. */
  size?: 'md' | 'lg';
  /** Wrap the mark in the frosted-glass tile. */
  tile?: boolean;
}
const { showName = true, variant = 'default', size = 'md', tile = true } = Astro.props;

const { viewBox, body } = parseMark(markSource);
const markup = paintMark(body, MARK_PALETTES[variant]);
---

<span class:list={['logo', `size-${size}`, `variant-${variant}`]}>
  <span
    class:list={['tile', tile && 'glass-tile', tile && variant === 'light' && 'glass-tile-dark']}
  >
    <svg class="mark" viewBox={viewBox} aria-hidden="true" focusable="false" set:html={markup} />
  </span>
  {showName && <span class="name">{site.name}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  /* Fixed box: the nav never shifts while fonts load. */
  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
  }

  .mark {
    display: block;
    width: 1.25rem;
    height: auto;
    aspect-ratio: 308 / 380.5;
  }

  .size-lg .tile {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 26px;
  }

  .size-lg .mark {
    width: 2.8rem;
  }

  .name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.04em;
  }

  .variant-light .name {
    color: #fff;
  }
</style>
