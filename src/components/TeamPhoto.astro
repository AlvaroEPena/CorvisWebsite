---
import { Image } from 'astro:assets';

import type { TeamImages } from '../lib/team-photos';

/**
 * A founder's portrait in a refined glass frame: rounded, thin light edge, soft tinted shadow and a
 * faint sheen. A placeholder is decorative (empty alt, hidden from assistive technology).
 */
interface Props {
  images: TeamImages;
  /** Alt text for a real photo; ignored for the placeholder. */
  alt: string;
  /** True for the first photo on the page: loaded eagerly and at high priority (it may be the LCP). */
  priority?: boolean;
}
const { images, alt, priority = false } = Astro.props;
const { card, isPlaceholder } = images;
---

<div class:list={['frame', isPlaceholder && 'is-placeholder']} data-testid="team-photo">
  {isPlaceholder ? (
    // A vector file: nothing to resize or re-encode, so a plain image keeps the build lean.
    <img
      src={card.src}
      alt=""
      aria-hidden="true"
      width={card.width}
      height={card.height}
      loading="lazy"
      decoding="async"
      class="photo"
    />
  ) : (
    <Image
      src={card}
      alt={alt}
      width={card.width}
      height={card.height}
      format="avif"
      quality={42}
      widths={[320, 534]}
      sizes="(min-width: 48rem) 17rem, min(100vw - 4rem, 17rem)"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      class="photo"
    />
  )}
</div>

<style>
  .frame {
    position: relative;
    width: min(100%, 17rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgb(255 255 255 / 0.9);
    background: linear-gradient(145deg, rgb(228 228 255 / 0.8), rgb(255 236 214 / 0.8));
    box-shadow:
      inset 0 1px 0 #fff,
      0 1px 2px rgb(20 22 63 / 0.08),
      0 22px 38px -22px rgb(59 59 214 / 0.55);
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Light sheen across the top-left, like light on glass. Sits over the picture, never blurs it. */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(135deg, rgb(255 255 255 / 0.28), transparent 38%),
      linear-gradient(0deg, rgb(20 22 63 / 0.1), transparent 30%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.35);
    pointer-events: none;
  }
</style>
