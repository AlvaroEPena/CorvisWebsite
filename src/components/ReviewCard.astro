---
import { reviewsPage } from '../content/reviews-copy';
import { initialsOf, type Review, siteLinkOf } from '../lib/reviews';
import Monogram from './Monogram.astro';

interface Props {
  review: Review;
  index: number;
}
const { review, index } = Astro.props;
const href = siteLinkOf(review);
---

<figure class="card panel reveal" data-testid="review-card" data-review-id={review.id}>
  <span class="mark" aria-hidden="true">
    &ldquo;
  </span>
  <blockquote>
    <p>{review.quote}</p>
  </blockquote>
  <figcaption>
    <Monogram initials={initialsOf(review.name)} tone={index % 2 === 0 ? 'core' : 'vision'} />
    <span class="who">
      <strong>{review.name}</strong>
      <span class="role">
        {review.role}, {review.company}
      </span>
    </span>
  </figcaption>

  <div class="action">
    {href ? (
      <a class="btn btn-glass btn-shine" href={href} data-testid="review-site-link">
        {reviewsPage.viewSite}
        <svg class="btn-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d="M4 10h11m-4-5 5 5-5 5"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
      </a>
    ) : (
      <span class="soon" title={reviewsPage.comingSoon}>
        <button class="btn btn-glass" type="button" disabled data-testid="review-site-disabled">
          {reviewsPage.viewSite}
        </button>
        <span class="soon-note">{reviewsPage.comingSoon}</span>
      </span>
    )}
  </div>
</figure>

<style>
  .card {
    position: relative;
    display: grid;
    gap: 1.5rem;
    margin: 0 0 1.25rem;
    padding: clamp(1.5rem, 2.6vw, 2.1rem);
    break-inside: avoid;
    overflow: hidden;
  }

  /* Large decorative quote mark behind the text. */
  .mark {
    position: absolute;
    top: -0.35rem;
    right: 1.1rem;
    font-family: var(--font-display);
    font-size: 8rem;
    line-height: 1;
    background: linear-gradient(160deg, rgb(124 124 255 / 0.5), rgb(255 138 43 / 0.35));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    pointer-events: none;
  }

  blockquote {
    position: relative;
    margin: 0;
  }

  blockquote p {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .who {
    display: grid;
    line-height: 1.3;
  }

  .role {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .action {
    display: flex;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .btn {
    min-height: 2.75rem;
    padding: 0.6rem 1.25rem;
    font-size: 0.92rem;
  }

  .soon {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    cursor: not-allowed;
  }

  /* Disabled: a calm, faded glass pill with a dashed edge, clearly not broken. */
  .soon .btn {
    cursor: not-allowed;
    border-style: dashed;
    border-color: rgb(20 22 63 / 0.22);
    background: rgb(255 255 255 / 0.45);
    box-shadow: none;
    color: var(--ink-soft);
  }

  .soon-note {
    padding: 0.2rem 0.65rem;
    border-radius: var(--radius-pill);
    background: rgb(59 59 214 / 0.09);
    color: var(--core-900);
    font-size: 0.78rem;
    font-weight: 600;
  }
</style>
