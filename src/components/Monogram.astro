---
/**
 * Initials in a frosted-glass tile: the stand-in for a photo. Decorative; the name is always
 * written out next to it. Tone alternates between the two brand accents.
 */
interface Props {
  initials: string;
  size?: 'md' | 'lg';
  tone?: 'core' | 'vision';
}
const { initials, size = 'md', tone = 'core' } = Astro.props;
---

<span class:list={['monogram', 'glass-tile', `size-${size}`, `tone-${tone}`]} aria-hidden="true">
  {initials}
</span>

<style>
  .monogram {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 16px;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--core-900);
  }

  .tone-core {
    background:
      radial-gradient(120% 70% at 25% 0%, rgb(255 255 255 / 0.95), transparent 60%),
      linear-gradient(145deg, rgb(228 228 255 / 0.95), rgb(124 124 255 / 0.55));
  }

  .tone-vision {
    color: #5a2a05;
    background:
      radial-gradient(120% 70% at 25% 0%, rgb(255 255 255 / 0.95), transparent 60%),
      linear-gradient(145deg, rgb(255 236 214 / 0.95), rgb(255 138 43 / 0.5));
  }

  .size-lg {
    width: 6rem;
    height: 6rem;
    border-radius: 28px;
    font-size: 2rem;
  }
</style>
