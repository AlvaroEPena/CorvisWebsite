---
import type { ImageMetadata } from 'astro';
import { projects } from '../content/projects';
import ProjectShowcase from './ProjectShowcase.astro';

// Resolves every portfolio photo once; keys look like "pool/pool-01".
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio/**/*.avif', {
  eager: true,
});
const images = Object.fromEntries(
  Object.entries(modules).map(([path, module]) => [
    path.replace('../assets/portfolio/', '').replace(/\.avif$/, ''),
    module.default,
  ]),
);
---

<section class="work section" id="work" aria-labelledby="work-title" data-testid="work">
  <div class="aura" style="--aura-color:rgb(124 124 255 / .26);top:0;left:-28rem"></div>
  <div class="container">
    <div class="section-heading reveal">
      <h2 id="work-title">Sites that sound like the business behind them.</h2>
      <p>
        {projects.length === 1
          ? 'Our first sample project, shown as concept work while we publish real case studies.'
          : 'Sample projects, shown as concept work while we publish real case studies.'}
      </p>
    </div>

    <div class="list" data-count={projects.length}>
      {projects.map((project, index) => (
        <div class="item reveal">
          <ProjectShowcase project={project} images={images} index={index} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .list {
    display: grid;
    gap: clamp(4rem, 8vw, 7rem);
  }
</style>
