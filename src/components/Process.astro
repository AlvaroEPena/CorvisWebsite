---
import { processSteps } from '../content/process';
---

<section
  class="process section"
  id="process"
  aria-labelledby="process-title"
  data-testid="process"
  data-process-pin
>
  <div class="pin">
    <div class="container">
      <div class="section-heading reveal">
        <h2 id="process-title">How a project moves, from hello to live.</h2>
        <p>Five clear stages, one point of contact and no mystery about what happens next.</p>
      </div>

      <ol class="steps">
        {processSteps.map((step) => (
          <li class="step">
            <span class="orb" aria-hidden="true"></span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import '../scripts/process-pin';
</script>

<style>
  .steps {
    position: relative;
    display: grid;
    gap: 2.25rem;
    margin: 0;
    padding: 0 0 0 2.25rem;
    list-style: none;
  }

  /* Mobile: a vertical thread linking the orbs. */
  .steps::before {
    content: '';
    position: absolute;
    left: 0.85rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: linear-gradient(var(--core-400), var(--vision-500));
    opacity: 0.55;
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.5rem;
  }

  .orb {
    position: absolute;
    left: -2.25rem;
    top: 0.2rem;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background:
      radial-gradient(circle at 34% 28%, #fff 0 12%, transparent 34%),
      radial-gradient(circle at 50% 55%, #ffc083, #ff8a2b 60%, #c2410a);
    box-shadow: 0 8px 14px -6px rgb(180 68 10 / 0.6);
  }

  h3 {
    font-size: 1.55rem;
  }

  p {
    color: var(--ink-soft);
    max-width: 22rem;
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1.5rem;
      padding: 0;
    }

    /* Desktop: a horizontal thread running through the orbs. */
    .steps::before {
      left: 0;
      right: 0;
      top: 1.05rem;
      bottom: auto;
      width: auto;
      height: 2px;
    }

    .step {
      padding-top: 3.5rem;
    }

    .orb {
      left: 0;
      top: 0;
      width: 2.1rem;
      height: 2.1rem;
    }
  }

  /*
   * Phones and touch screens: the route stays hidden until a stop reaches the middle of the screen, then
   * it lights up and stays lit for the rest of the page load (scripts/process-pin.ts adds data-lit and
   * sets --p, the thread length). Only transform and opacity change. Without JS, and with reduced
   * motion, the finished route is shown and the text is always there.
   */
  @media (prefers-reduced-motion: no-preference) and (not ((min-width: 64rem) and (hover: hover))) {
    :global(:root[data-js]) .steps::before {
      transform: scaleY(var(--p, 0));
      transform-origin: top;
      transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }

    :global(:root[data-js]) .orb {
      opacity: 0;
      transform: scale(0);
      transition:
        transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.3s ease;
    }

    :global(:root[data-js]) .step[data-lit] .orb {
      opacity: 1;
      transform: scale(1);
    }
  }

  /*
   * Desktop with a pointer: the section is pinned in the middle of the screen and scroll fills the
   * timeline (scripts/process-pin.ts sets --p and marks each lit stop). After one pass the extra
   * height goes away (data-pin-done). Without JS, or on touch and small screens, the finished route
   * is shown, and the text is always there.
   */
  @media (min-width: 64rem) and (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(:root[data-js]) .process {
      --pin-extra: 110svh;
      height: calc(100svh + var(--pin-extra));
      padding-block: 0;
    }

    :global(:root[data-js]) .process[data-pin-done] {
      height: 100svh;
    }

    :global(:root[data-js]) .pin {
      position: sticky;
      top: 0;
      display: grid;
      align-content: center;
      min-height: 100svh;
    }

    :global(:root[data-js]) .steps::before {
      transform: scaleX(var(--p, 0));
      transform-origin: left;
    }

    :global(:root[data-js]) .orb {
      opacity: 0;
      transform: scale(0);
      transition:
        transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
        opacity 0.3s ease;
    }

    :global(:root[data-js]) .step[data-lit] .orb {
      opacity: 1;
      transform: scale(1);
    }
  }
</style>
