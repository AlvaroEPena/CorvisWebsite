---
import { Image } from 'astro:assets';
import type { WorkProject } from '../content/projects';
import { getSandboxProject } from '../content/sandbox';
import { portfolioImage } from '../lib/portfolio-images';
import LiveSiteStage from './LiveSiteStage.astro';

interface Props {
  project: WorkProject;
  index: number;
}

const { project, index } = Astro.props;
const displayUrl = getSandboxProject(project.sandboxId)?.displayUrl ?? '';
const isReversed = index % 2 === 1;
---

<article
  class:list={['showcase', isReversed && 'reversed']}
  data-testid="project-showcase"
  data-project={project.id}
  data-sandbox-id={project.sandboxId}
  aria-labelledby={`project-${project.id}`}
>
  <div
    class="window"
    aria-hidden="true"
    data-testid="project-window"
    data-live-host
    data-browse-duration="26"
  >
    <div class="chrome">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="address">{displayUrl}</span>
    </div>
    <LiveSiteStage projectId={project.sandboxId} version="after" />
  </div>

  <div class="summary">
    <p class="label">{project.label}</p>
    <h3 id={`project-${project.id}`}>{project.name}</h3>
    <p class="category">{project.category}</p>
    <p>{project.summary}</p>
    <p class="origin" data-testid="project-origin">
      {project.originNote}
    </p>
    <div class="cols">
      <div>
        <h4>What we built</h4>
        <ul>
          {project.built.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
      <div>
        <h4>Why it works</h4>
        <ul>
          {project.whyItWorks.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    </div>
    <ul class="thumbs" aria-label="Project photography">
      {project.photos.map((photo) => (
        <li>
          <Image
            src={portfolioImage(project.folder, photo.file)}
            alt={photo.alt}
            width={240}
            height={180}
            sizes="120px"
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .showcase {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .window {
    border-radius: 24px;
    overflow: hidden;
    background: #fff;
    border: 1px solid rgb(255 255 255 / 0.8);
    box-shadow: 0 40px 80px -36px rgb(20 22 63 / 0.55);
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.7rem 1rem;
    background: linear-gradient(180deg, #f6f6fc, #ecebf5);
    border-bottom: 1px solid rgb(20 22 63 / 0.08);
  }

  /* The same red, yellow and green lights as the sandbox's browser frame. */
  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #ff6b5e;
  }

  .dot:nth-child(2) {
    background: #f6bd3a;
  }

  .dot:nth-child(3) {
    background: #3fc556;
  }

  .address {
    flex: 1;
    margin-left: 0.6rem;
    padding: 0.2rem 0.8rem;
    border-radius: 99px;
    background: #fff;
    color: var(--ink-mute);
    font-size: 0.78rem;
  }

  /* Every project's preview has the same box: one aspect ratio, and (below) the same column width. */
  .window :global(.live-stage) {
    aspect-ratio: 16 / 10;
  }

  .summary {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .label {
    padding: 0.3rem 0.85rem;
    border-radius: var(--radius-pill);
    background: rgb(25 181 165 / 0.14);
    color: #0b5d55;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .category {
    color: var(--core-600);
    font-weight: 600;
  }

  .origin {
    padding: 0.5rem 0.9rem;
    border-left: 3px solid var(--vision-500);
    background: rgb(255 255 255 / 0.6);
    border-radius: 0 12px 12px 0;
    font-weight: 600;
  }

  .summary > p:not(.label, .category) {
    max-width: 34rem;
    color: var(--ink-soft);
  }

  .cols {
    display: grid;
    gap: 1.5rem;
  }

  h4 {
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
  }

  .cols ul {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .thumbs {
    display: flex;
    gap: 0.6rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .thumbs :global(img) {
    display: block;
    width: 5.5rem;
    height: 4.2rem;
    border-radius: 12px;
    object-fit: cover;
    /* A soft tint shows while a lazy photo arrives, so it does not pop in against the page. */
    background: linear-gradient(145deg, rgb(228 228 255 / 0.9), rgb(255 236 214 / 0.9));
  }

  @media (min-width: 40rem) {
    .cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .showcase {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: 4rem;
    }
    /* Preview on the right: swap the columns too, so the preview keeps the same (wide) width. */
    .reversed {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
    .reversed .window {
      order: 2;
    }
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
