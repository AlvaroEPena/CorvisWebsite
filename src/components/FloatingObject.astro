---
/**
 * Soft-3D decorative objects built from CSS gradients (no images, no blur filters).
 * The outer element takes GSAP entrance/parallax; the inner one carries the CSS float.
 */
interface Props {
  kind: 'capsule' | 'bead' | 'ring' | 'spark';
  tone?: 'amber' | 'indigo' | 'teal' | 'pearl';
  /** Inline position and size (scoped CSS cannot be styled from the parent). */
  style: string;
  /** Parallax depth passed to the motion script (yPercent over the section). */
  parallax?: number;
  tilt?: string;
  delay?: string;
  entrance?: boolean;
}
const {
  kind,
  tone = 'amber',
  style,
  parallax,
  tilt = '0deg',
  delay = '0s',
  entrance = false,
} = Astro.props;
---

<span
  class="object"
  style={style}
  data-parallax={parallax}
  data-hero-obj={entrance ? '' : undefined}
  aria-hidden="true"
>
  <span class={`body float ${kind} ${tone}`} style={`--tilt:${tilt};--float-delay:${delay}`}>
    {kind === 'spark' && (
      <svg viewBox="0 0 40 40" focusable="false">
        <path d="M20 0c1.6 10.4 9.6 18.4 20 20-10.4 1.6-18.4 9.6-20 20-1.6-10.4-9.6-18.4-20-20C10.4 18.4 18.4 10.4 20 0Z" />
      </svg>
    )}
  </span>
</span>

<style>
  .object {
    position: absolute;
    display: block;
    pointer-events: none;
  }

  .body {
    display: block;
    width: 100%;
    height: 100%;
    transform: rotate(var(--tilt));
  }

  .capsule {
    border-radius: 999px;
    box-shadow:
      inset 0 -10px 18px rgb(0 0 0 / 0.18),
      inset 0 8px 14px rgb(255 255 255 / 0.55),
      0 24px 34px -14px rgb(20 22 63 / 0.55);
  }

  .capsule.amber {
    background:
      linear-gradient(100deg, rgb(255 255 255 / 0.55) 0 14%, transparent 34%),
      linear-gradient(160deg, #ffd9a8, #ff8a2b 55%, #d2410a);
  }

  .capsule.indigo {
    background:
      linear-gradient(100deg, rgb(255 255 255 / 0.45) 0 14%, transparent 34%),
      linear-gradient(160deg, #a9a9ff, #3b3bd6 55%, #14163f);
  }

  .capsule.teal {
    background:
      linear-gradient(100deg, rgb(255 255 255 / 0.5) 0 14%, transparent 34%),
      linear-gradient(160deg, #8ff0e3, #19b5a5 55%, #0b5d55);
  }

  .bead {
    border-radius: 50%;
    box-shadow:
      inset -6px -8px 14px rgb(20 22 63 / 0.22),
      0 18px 26px -12px rgb(20 22 63 / 0.5);
  }

  .bead.pearl {
    background:
      radial-gradient(circle at 32% 28%, #fff 0 12%, rgb(255 255 255 / 0) 34%),
      radial-gradient(circle at 60% 70%, #d9d6ff, #f6f3ef 70%);
  }

  .bead.amber {
    background:
      radial-gradient(circle at 32% 28%, #fff 0 10%, rgb(255 255 255 / 0) 30%),
      radial-gradient(circle at 55% 60%, #ffc083, #ff8a2b 60%, #c2410a);
  }

  .bead.indigo {
    background:
      radial-gradient(circle at 32% 28%, #fff 0 9%, rgb(255 255 255 / 0) 28%),
      radial-gradient(circle at 55% 60%, #7c7cff, #3b3bd6 55%, #14163f);
  }

  .bead.teal {
    background:
      radial-gradient(circle at 32% 28%, #fff 0 9%, rgb(255 255 255 / 0) 28%),
      radial-gradient(circle at 55% 60%, #7fe9db, #19b5a5 55%, #0b5d55);
  }

  .ring {
    border-radius: 50%;
    border: 10px solid transparent;
    background: linear-gradient(135deg, rgb(255 255 255 / 0.85), rgb(255 255 255 / 0.1)) border-box;
    -webkit-mask:
      linear-gradient(#000 0 0) padding-box exclude,
      linear-gradient(#000 0 0);
    mask:
      linear-gradient(#000 0 0) padding-box exclude,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: xor;
    opacity: 0.9;
  }

  .spark svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: #ff8a2b;
    filter: drop-shadow(0 6px 10px rgb(180 68 10 / 0.35));
  }

  .spark.pearl svg {
    fill: #fff;
  }
</style>
