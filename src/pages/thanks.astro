---
import Logo from '../components/Logo.astro';
import { site } from '../content/site';
import Layout from '../layouts/Layout.astro';

const nextSteps = [
  'We will email you within 1 business day to confirm your deposit and kick things off.',
  'You will receive a plain-English agreement to e-sign through PandaDoc.',
  'We book your discovery call and start finding the core of your business.',
];
---

<Layout
  title={`Thank you | ${site.name}`}
  description="Your deposit is confirmed. Here is what happens next."
  noindex
>
  <section class="thanks section" aria-labelledby="thanks-title" data-testid="thanks">
    <div class="aura" style="--aura-color:rgb(255 192 131 / .5);top:-8rem;right:-14rem"></div>
    <div class="container">
      <div class="panel box">
        <h1 id="thanks-title">Thank you. You are in.</h1>
        <p class="lead">Your payment went through and a receipt is on its way from Stripe.</p>
        <h2>What happens next</h2>
        <ol class="next">
          {nextSteps.map((step) => (
            <li>{step}</li>
          ))}
        </ol>
        <a class="btn btn-primary" href="/">
          Back to the homepage
        </a>
        <span class="emblem" aria-hidden="true">
          <Logo size="lg" showName={false} />
        </span>
      </div>
    </div>
  </section>
</Layout>

<style>
  .thanks {
    min-height: 60dvh;
    display: grid;
    align-items: center;
  }

  .box {
    position: relative;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding: clamp(2rem, 6vw, 4rem);
    overflow: hidden;
  }

  .emblem {
    position: absolute;
    top: 2rem;
    right: 2rem;
    display: none;
  }

  @media (min-width: 48rem) {
    .emblem {
      display: block;
    }
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    max-width: 14ch;
  }

  h2 {
    margin-top: 0.5rem;
    font-size: 1.4rem;
    letter-spacing: -0.02em;
  }

  .lead {
    max-width: 32rem;
    color: var(--ink-soft);
    font-size: 1.15rem;
  }

  .next {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.2rem;
    list-style: decimal;
    max-width: 34rem;
    color: var(--ink-soft);
  }
</style>
