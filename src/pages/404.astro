---
import FloatingObject from '../components/FloatingObject.astro';
import { site } from '../content/site';
import Layout from '../layouts/Layout.astro';
---

<Layout title={`Page not found | ${site.name}`} description="That page does not exist." noindex>
  <section class="lost section" aria-labelledby="lost-title">
    <div class="aura" style="--aura-color:rgb(255 192 131 / .5);top:-8rem;right:-14rem"></div>
    <div class="container">
      <div class="panel box">
        <p class="eyebrow">Error 404</p>
        <h1 id="lost-title">This page lost its vision.</h1>
        <p>The page you asked for is not here. It may have moved, or the link may be mistyped.</p>
        <a class="btn btn-primary" href="/">
          Back to the homepage
        </a>
        <FloatingObject
          kind="bead"
          tone="amber"
          style="width:6rem;height:6rem;right:2rem;top:2rem"
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .lost {
    min-height: 60dvh;
    display: grid;
    align-items: center;
  }

  .box {
    position: relative;
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding: clamp(2rem, 6vw, 4rem);
    overflow: hidden;
  }

  h1 {
    font-size: clamp(2.4rem, 7vw, 4.5rem);
    line-height: 1;
    max-width: 14ch;
  }

  p:not(.eyebrow) {
    max-width: 32rem;
    color: var(--ink-soft);
  }
</style>
