{
  // Cloudflare Workers static assets + the contact Worker. Deploy only with owner confirmation.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corvis",
  "main": "src/worker/index.ts",
  // The site is served on thecorvis.com only. Without these, every deploy turns the public
  // corvis.modlabs.workers.dev address (and per-version preview addresses) back on.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  // Non-secret settings, applied on every deploy so the dashboard cannot drift from the repo. Secrets
  // (RESEND_API_KEY, TURNSTILE_SECRET_KEY) stay in the dashboard. A local .env or .dev.vars overrides these.
  "vars": {
    "ENVIRONMENT": "production",
    "CONTACT_TO_EMAIL": "thecorvisllc@gmail.com",
    "CONTACT_FROM_EMAIL": "Corvis <aaron@thecorvis.com>",
  },
}
