# Public base URL of the deployed site (canonical URLs, sitemap, OG).
PUBLIC_SITE_URL=http://localhost:4328
# Cloudflare Turnstile site key (public). Unset = Cloudflare's always-pass test key in dev.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Worker secrets (wrangler secret put / .dev.vars; never commit) ---
# Resend API key. Unset = demo mode: Worker logs the lead and returns ok.
RESEND_API_KEY=
# Where leads are delivered.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Corvis <hello@your-domain>".
CONTACT_FROM_EMAIL=
# Turnstile secret. Unset = test secret (dev only).
TURNSTILE_SECRET_KEY=
