# Public base URL of the deployed site (canonical URLs, sitemap, OG).
PUBLIC_SITE_URL=http://localhost:4328
# Cloudflare Turnstile site key (public, read at build time). Unset = Cloudflare's always-pass test key.
PUBLIC_TURNSTILE_SITE_KEY=
# Search engine ownership tags (optional, public). Paste only the content value from Google Search
# Console / Bing Webmaster Tools "HTML tag" verification; blank = no tag. A DNS-verified domain does
# not need them.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# --- Worker secrets (wrangler secret put / .dev.vars; never commit) ---
# Resend API key (Sending access, limited to your domain). Used only when ENVIRONMENT=production.
RESEND_API_KEY=
# Where lead notifications are delivered (your real inbox, e.g. thecorvisllc@gmail.com).
CONTACT_TO_EMAIL=
# Sender of the notification; no inbox needed, any address on your verified Resend domain.
# e.g. Corvis Website <website@thecorvis.com>
CONTACT_FROM_EMAIL=
# Turnstile secret. Required when ENVIRONMENT=production (the Worker fails closed without it).
TURNSTILE_SECRET_KEY=

# --- Mode ---
# production  = real services: the real Turnstile secret and real emails through Resend. Any missing
#               value makes the Worker refuse leads (it fails closed).
# development = what it has always done: Cloudflare's always-pass Turnstile test secret, and the lead
#               is logged, not emailed, even if real keys are set.
# Unset or anything else = development. On Cloudflare set this to production (Worker variable).
ENVIRONMENT=development

# --- Reviews admin (public build-time values; defaults shown) ---
# GitHub repo and branch the /admin editor commits to.
PUBLIC_CMS_REPO=AlvaroEPena/CorvisWebsite
PUBLIC_CMS_BRANCH=main
