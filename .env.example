# Public base URL of the deployed site (canonical URLs, sitemap, OG).
PUBLIC_SITE_URL=http://localhost:4328
# Cloudflare Turnstile site key (public). Unset = Cloudflare's always-pass test key in dev.
PUBLIC_TURNSTILE_SITE_KEY=
# Search engine ownership tags (optional, public). Paste only the content value from Google Search
# Console / Bing Webmaster Tools "HTML tag" verification; blank = no tag. A DNS-verified domain does
# not need them.
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=

# --- Worker secrets (wrangler secret put / .dev.vars; never commit) ---
# Resend API key. Unset = demo mode: Worker logs the lead and returns ok.
RESEND_API_KEY=
# Where leads are delivered.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Corvis <hello@your-domain>".
CONTACT_FROM_EMAIL=
# Turnstile secret. REQUIRED in production (Worker fails closed without it).
TURNSTILE_SECRET_KEY=

# --- Local dev only: put this in .dev.vars, NEVER in wrangler.jsonc or production secrets ---
# Enables Cloudflare's always-pass Turnstile test secret and demo mode when keys are unset.
ENVIRONMENT=development

# --- Reviews admin (public build-time values; defaults shown) ---
# GitHub repo and branch the /admin editor commits to.
PUBLIC_CMS_REPO=AlvaroEPena/CorvisWebsite
PUBLIC_CMS_BRANCH=main
